#!/bin/sh
set -e

case "$1" in
  remove|deconfigure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl disable --now aryaos-ipv4ll-apply.service aryaos-time-refresh.path aryaos-time-refresh.timer aryaos-time-bootstrap.service aryaos-time-ready.target aryaos-time-floor.service aryaos-web-tls-init.service aryaos-tak-dp-importd.service aryaos-multicast-links.service gutcheck.service 2>/dev/null || true
    fi
    ;;
esac

exit 0
