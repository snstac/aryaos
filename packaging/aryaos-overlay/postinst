#!/bin/sh
set -e

case "$1" in
  configure)
    getent group gpsd >/dev/null 2>&1 || groupadd --system gpsd || true
    getent group tak-certs >/dev/null 2>&1 || groupadd --system tak-certs || true
    usermod -aG gpsd www-data 2>/dev/null || true
    usermod -aG gpsd lincot 2>/dev/null || true
    usermod -aG ssl-cert www-data 2>/dev/null || true
    usermod -aG video www-data 2>/dev/null || true
    usermod -aG video lincot 2>/dev/null || true

    gpsd_defaults=/usr/share/aryaos/defaults/gpsd.default
    gpsd_config=/etc/default/gpsd
    if [ -f "$gpsd_defaults" ]; then
      if [ ! -f "$gpsd_config" ]; then
        install -m 0644 -o root -g root "$gpsd_defaults" "$gpsd_config"
      else
        # Preserve the protocol-verified stable DEVICES path and any operator
        # settings. Add new package defaults only when an older config lacks
        # the key; factory reset separately restores the complete template.
        for gpsd_key in START_DAEMON GPSD_OPTIONS OPTIONS DEVICES USBAUTO; do
          if ! grep -q "^${gpsd_key}=" "$gpsd_config"; then
            gpsd_line="$(grep "^${gpsd_key}=" "$gpsd_defaults" | tail -n 1)"
            [ -n "$gpsd_line" ] && printf '\n%s\n' "$gpsd_line" >> "$gpsd_config"
          fi
        done
      fi
    fi
    dronescout_defaults=/usr/share/aryaos/defaults/dronecot-dronescout.default
    dronescout_config=/etc/default/dronecot-dronescout
    if [ -f "$dronescout_defaults" ]; then
      if [ ! -f "$dronescout_config" ]; then
        install -m 0644 -o root -g root "$dronescout_defaults" "$dronescout_config"
      elif ! grep -q '^SERIAL_CRLF_NORMALIZE=' "$dronescout_config"; then
        dronescout_crlf=0
        if command -v udevadm >/dev/null 2>&1 \
          && udevadm info -q property -n /dev/dronescout 2>/dev/null \
            | grep -q '^ID_VENDOR_ID=303a$'; then
          dronescout_crlf=1
        fi
        printf '\n# Repair ESP console LF-to-CRLF expansion in binary MAVLink.\nSERIAL_CRLF_NORMALIZE=%s\n' "$dronescout_crlf" >> "$dronescout_config"
      fi
    fi
    # Each independently managed DroneCOT service needs its own PyTAK status
    # namespace. Migrate existing conffiles in place without replacing local
    # feed or sensor settings.
    for dronecot_instance in dronescout wifi ble; do
      instance_config="/etc/default/dronecot-$dronecot_instance"
      if [ -f "$instance_config" ] && ! grep -q '^STATUS_APP=' "$instance_config"; then
        printf '\nSTATUS_APP=dronecot-%s\n' "$dronecot_instance" >> "$instance_config"
      fi
    done
    # AryaOS 2.2 makes the formerly generic DJI/AntSDR instance explicit.
    # Preserve an operator's existing feed/bind settings, but never leave both
    # units runnable: the upstream generic service is masked after migration.
    dji_defaults=/usr/share/aryaos/defaults/dronecot-dji.default
    dji_config=/etc/default/dronecot-dji
    legacy_dji_config=/etc/default/dronecot
    legacy_dji_enabled=0
    if command -v systemctl >/dev/null 2>&1 \
      && systemctl is-enabled --quiet dronecot.service 2>/dev/null; then
      legacy_dji_enabled=1
    fi
    if [ ! -f "$dji_config" ]; then
      if [ -f "$legacy_dji_config" ]; then
        install -m 0644 -o root -g root "$legacy_dji_config" "$dji_config"
      elif [ -f "$dji_defaults" ]; then
        install -m 0644 -o root -g root "$dji_defaults" "$dji_config"
      fi
    fi
    if [ -f "$dji_config" ] && [ -f "$dji_defaults" ]; then
      sed -i '/^#\?FEED_URL=/d' "$dji_config"
      for dji_key in DJI_TCP_PORT DJI_BIND_ADDRESS DJI_SENSOR_NAME SENSOR_KEEPALIVE_PERIOD STATUS_APP; do
        if ! grep -q "^${dji_key}=" "$dji_config"; then
          dji_line="$(grep "^${dji_key}=" "$dji_defaults" | tail -n 1)"
          [ -n "$dji_line" ] && printf '\n%s\n' "$dji_line" >> "$dji_config"
        fi
      done
      sed -i 's/^STATUS_APP=.*/STATUS_APP=dronecot-dji/' "$dji_config"
    fi
    if [ ! -f /etc/aryaos/aryaos-config.txt ] && [ -f /usr/share/aryaos/defaults/aryaos-config.txt ]; then
      install -d -m 0755 /etc/aryaos
      install -m 0644 -o root -g root /usr/share/aryaos/defaults/aryaos-config.txt /etc/aryaos/aryaos-config.txt
    fi
    aryaos_config=/etc/aryaos/aryaos-config.txt
    aryaos_defaults=/usr/share/aryaos/defaults/aryaos-config.txt
    if [ -f "$aryaos_config" ] && [ -f "$aryaos_defaults" ]; then
      for key in ARYAOS_COT_OUTPUT_URL ARYAOS_ADSB_1090_SOURCE \
        ARYAOS_ADSB_1090_DEVICE ARYAOS_UAT_978_DEVICE \
        PYTAK_MULTICAST_LOCAL_ADDRS ARYAOS_IPV4LL_FALLBACK; do
        if ! grep -q "^${key}=" "$aryaos_config"; then
          default_line="$(grep "^${key}=" "$aryaos_defaults" | tail -n 1)"
          [ -n "$default_line" ] && printf '\n%s\n' "$default_line" >> "$aryaos_config"
        fi
      done
      # Older discovery releases configured a protocol-verified ADSBee as a
      # Pico Beast serial input but had no persistent source marker. Preserve
      # that evidence so Cockpit and HIL distinguish it from a generic SDR.
      if grep -q -- '--device-type modesbeast' /etc/default/readsb 2>/dev/null \
        && grep -q -- '--beast-serial /dev/serial/by-id/usb-Raspberry_Pi_Pico_' /etc/default/readsb 2>/dev/null; then
        adsbee_device="$(sed -n 's|.*--beast-serial \([^ ]*\).*|\1|p' /etc/default/readsb | head -n 1)"
        sed -i 's/^ARYAOS_ADSB_1090_SOURCE=.*/ARYAOS_ADSB_1090_SOURCE=adsbee/' "$aryaos_config"
        sed -i "s|^ARYAOS_ADSB_1090_DEVICE=.*|ARYAOS_ADSB_1090_DEVICE=\"$adsbee_device\"|" "$aryaos_config"
      fi
    fi
    # Materialize the optional NetworkManager IPv4LL default and migrate
    # existing ordinary DHCP Ethernet profiles without reconnecting them.
    if [ -x /usr/local/sbin/aryaos-ipv4ll ]; then
      if grep -Eq '^ARYAOS_IPV4LL_FALLBACK=(0|false|no|off)$' "$aryaos_config" 2>/dev/null; then
        /usr/local/sbin/aryaos-ipv4ll disable >/dev/null 2>&1 || true
      else
        /usr/local/sbin/aryaos-ipv4ll enable >/dev/null 2>&1 || true
      fi
    fi
    # Collapse pre-COTBridge lane layouts into one operator-facing site output.
    # The helper preserves TLS lane options and disables every legacy lane so
    # an upgrade cannot send duplicate events.
    if [ -x /usr/local/sbin/aryaos-site-output ]; then
      /usr/local/sbin/aryaos-site-output --migrate >/dev/null 2>&1 || true
    fi
    for banner in issue issue.net motd; do
      if [ -f "/usr/share/aryaos/defaults/$banner" ]; then
        install -m 0644 -o root -g root "/usr/share/aryaos/defaults/$banner" "/etc/$banner"
      fi
    done
    # SSH sends issue.net before the client's password prompt. CRLF is
    # intentional here: a bare LF leaves some Windows terminals at the old
    # column, visually prepending the next prompt to the banner.
    sed -i 's/\r$//; s/$/\r/' /etc/issue.net

    for user in adsbcot aiscot dronecot lincot cotbridge; do
      if getent passwd "$user" >/dev/null 2>&1; then
        usermod -aG tak-certs "$user" 2>/dev/null || true
      fi
    done

    for conf in 94-aryaos-setenv-module.conf 95-aryaos-cockpit-https.conf 99-aryaos-recorder.conf; do
      if [ -f "/etc/lighttpd/conf-available/$conf" ]; then
        ln -sf "/etc/lighttpd/conf-available/$conf" "/etc/lighttpd/conf-enabled/$conf"
      fi
    done
    for mod in openssl proxy redirect cgi deflate; do
      if [ -f "/etc/lighttpd/conf-available/10-$mod.conf" ]; then
        ln -sf "/etc/lighttpd/conf-available/10-$mod.conf" "/etc/lighttpd/conf-enabled/10-$mod.conf"
      fi
    done

    if [ -r /etc/ssl/certs/ssl-cert-snakeoil.pem ] && [ -r /etc/ssl/private/ssl-cert-snakeoil.key ]; then
      install -d -m 0755 /etc/lighttpd/ssl
      umask 077
      cat /etc/ssl/certs/ssl-cert-snakeoil.pem /etc/ssl/private/ssl-cert-snakeoil.key > /etc/lighttpd/ssl/snakeoil-combined.pem.tmp
      mv -f /etc/lighttpd/ssl/snakeoil-combined.pem.tmp /etc/lighttpd/ssl/snakeoil-combined.pem
      chmod 0640 /etc/lighttpd/ssl/snakeoil-combined.pem
      chgrp ssl-cert /etc/lighttpd/ssl/snakeoil-combined.pem 2>/dev/null || true
    fi

    if [ -f /usr/share/aryaos/cockpit/branding.css ]; then
      install -d -m 0755 /usr/share/cockpit/branding/debian /usr/share/cockpit/branding/default
      install -m 0644 -o root -g root /usr/share/aryaos/cockpit/branding.css /usr/share/cockpit/branding/debian/branding.css
      install -m 0644 -o root -g root /usr/share/aryaos/cockpit/branding.css /usr/share/cockpit/branding/default/branding.css
      if [ -f /usr/share/aryaos/cockpit/mark-aryaos-rev.svg ]; then
        install -m 0644 -o root -g root /usr/share/aryaos/cockpit/mark-aryaos-rev.svg /usr/share/cockpit/branding/debian/mark-aryaos-rev.svg
        install -m 0644 -o root -g root /usr/share/aryaos/cockpit/mark-aryaos-rev.svg /usr/share/cockpit/branding/default/mark-aryaos-rev.svg
      fi
    fi

    if command -v systemctl >/dev/null 2>&1; then
      # Installing the AryaOS rpi-swap drop-in changes the generated topology
      # from zram+file to file-free zram. Stop the old generated timer before
      # daemon-reload makes its trigger unit vanish; otherwise systemd records
      # a synthetic failed unit and leaves the appliance degraded until reboot.
      systemctl stop rpi-zram-writeback.timer 2>/dev/null || true
      systemctl daemon-reload || true
      systemctl reset-failed rpi-zram-writeback.timer 2>/dev/null || true
      systemctl reset-failed NetworkManager-wait-online.service 2>/dev/null || true
      systemctl start NetworkManager-wait-online.service 2>/dev/null || true
      systemctl disable --now aryaos-neighbord.service dronecot.service 2>/dev/null || true
      systemctl mask dronecot.service 2>/dev/null || true
      rm -f /etc/systemd/system/aryaos-neighbord.service /usr/local/sbin/aryaos-neighbord
      systemctl daemon-reload || true
      systemctl enable aryaos-firstboot.service aryaos-gps-time-sync.service aryaos-tak-dp-importd.service aryaos-multicast-links.service aryaos-radio-silence.service aryaos-serial-assign.service NetworkManager-dispatcher.service gutcheck.service 2>/dev/null || true
      if [ "$legacy_dji_enabled" = 1 ]; then
        systemctl enable dronecot-dji.service 2>/dev/null || true
      fi
      # Network GPS is core plumbing, independent of the selected sensor role.
      systemctl enable --now gpscot.service 2>/dev/null || true
      # Time service: chrony (GPS-disciplined + serves the local network) replaces
      # the client-only systemd-timesyncd.
      systemctl disable --now systemd-timesyncd.service 2>/dev/null || true
      systemctl enable chrony.service 2>/dev/null || true
      # Hardening: activate sysctl/sshd/fail2ban/firewalld config shipped by
      # this package (no-ops in image-build chroots where nothing is running).
      systemctl enable firewalld.service fail2ban.service 2>/dev/null || true
      # Media longevity: periodic TRIM for SD/NVMe. zram swap config is shipped
      # to /etc/systemd/zram-generator.conf (activates via systemd-zram-generator).
      systemctl enable fstrim.timer 2>/dev/null || true
      sysctl --system >/dev/null 2>&1 || true
      systemctl reload ssh.service 2>/dev/null || true
      systemctl try-restart fail2ban.service 2>/dev/null || true
      firewall-cmd --reload >/dev/null 2>&1 || true
      systemctl restart aryaos-tak-dp-importd.service aryaos-multicast-links.service cotbridge.service gutcheck.service lighttpd.service 2>/dev/null || true
      if systemctl is-enabled --quiet gdlcot.service 2>/dev/null; then
        systemctl reset-failed gdlcot.service 2>/dev/null || true
        systemctl restart gdlcot.service 2>/dev/null || true
      fi
      # Fill missing gpsd defaults above without replacing its verified device.
      # Rerun discovery to exercise new classifiers and detect hardware changes;
      # an unchanged stable assignment takes the no-interruption fast path.
      systemctl restart aryaos-serial-assign.service 2>/dev/null || true
      # These are role-dependent, so refresh only instances that were already
      # running; package installation must not enable a new radio role.
      systemctl try-restart lincot.service acarsdec.service dronecot-dji.service dronecot-dronescout.service 2>/dev/null || true
      # aryaos-serial-assign already resumed gpsd with the detected device.
      # Restarting the socket/service pair again races the tty open path.
      systemctl try-restart cockpit.socket 2>/dev/null || true
      systemctl start aryaos-gps-time-sync.service 2>/dev/null || true
    fi

    if [ -x /usr/local/sbin/patch-cockpit-aryaos-dp ]; then
      /usr/local/sbin/patch-cockpit-aryaos-dp >/dev/null 2>&1 || true
    fi
    # raspberrypi-sys-mods rewrites cmdline.txt on the first resize boot. Build
    # our read-back-verified replacement into every installed initramfs before
    # the appliance is allowed to reboot.
    if command -v update-initramfs >/dev/null 2>&1; then
      update-initramfs -u -k all
    fi
    rm -rf /var/lib/cockpit/*/cache 2>/dev/null || true
    ;;
esac

exit 0
