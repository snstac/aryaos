[cotbridge]
DEBUG = false

[lane:site-output]
enabled = true
mode = forward
ingress_cot_url = {{ cotbridge_ingress_cot_url }}
egress_cot_url = {{ cotbridge_egress_cot_url }}
PYTAK_NO_HELLO = true
