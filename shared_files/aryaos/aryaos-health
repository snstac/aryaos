#!/usr/bin/python3
"""Aggregate current gateway status documents for Cockpit and support tools."""

import argparse
import json
import subprocess
import time
from pathlib import Path

APPS = (
    "cotbridge",
    "gpscot",
    "lincot",
    "gutcheck",
    "adsbcot",
    "aiscot",
    "acarscot",
    "aprscot",
    "gdlcot",
    "dronecot-dji",
    "dronecot-wifi",
    "dronecot-ble",
    "dronecot-dronescout",
    "sikw00fcot",
    "sapientcot",
)

STATUS_ROOT = Path("/run")
SYSTEMD_ONLY_APPS = {"gutcheck"}
ENABLED_STATES = {"enabled", "enabled-runtime"}
DISABLED_STATES = {
    "disabled",
    "masked",
    "masked-runtime",
    "static",
    "indirect",
    "not-found",
}


def service_state(app):
    """Return enough systemd state to classify a missing status document."""
    properties = (
        "LoadState",
        "UnitFileState",
        "ActiveState",
        "SubState",
        "Result",
        "NRestarts",
    )
    try:
        result = subprocess.run(
            [
                "systemctl",
                "show",
                f"{app}.service",
                "--no-pager",
                "--property=" + ",".join(properties),
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    state = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            state[key] = value
    if str(state.get("NRestarts", "")).isdigit():
        state["NRestarts"] = int(state["NRestarts"])
    return state


def service_health(state):
    """Return an authoritative health override from systemd, if any."""
    active = state.get("ActiveState")
    unit_file = state.get("UnitFileState")
    if active == "failed":
        return {"state": "fault", "detail": "service failed"}
    if active == "inactive" and state.get("Result") == "exec-condition":
        return {"state": "unavailable", "detail": "required hardware is not present"}
    if active in ("activating", "deactivating", "reloading"):
        return {"state": "degraded", "detail": f"service {active}"}
    if active == "inactive" and unit_file in ENABLED_STATES:
        return {"state": "fault", "detail": "enabled service inactive"}
    if (
        active == "inactive"
        and (unit_file in DISABLED_STATES or state.get("LoadState") == "not-found")
    ):
        return {"state": "disabled", "detail": "no runtime status"}
    return None


def missing_health(state):
    """Classify an absent runtime document without faulting unused roles."""
    override = service_health(state)
    if override:
        return override
    detail = (
        "service active; no runtime status"
        if state.get("ActiveState") == "active"
        else "no runtime status"
    )
    return {"state": "unknown", "detail": detail}


def load(app, now, root=STATUS_ROOT, state=None):
    state = service_state(app) if state is None else state
    service_override = service_health(state)
    if service_override:
        return {"app": app, "service": state, "health": service_override}
    path = Path(root) / app / "status.json"
    try:
        doc = json.loads(path.read_text())
    except (OSError, ValueError):
        if app in SYSTEMD_ONLY_APPS and state.get("ActiveState") == "active":
            return {
                "app": app,
                "service": state,
                "health": {"state": "ok", "detail": "service active"},
            }
        return {"app": app, "service": state, "health": missing_health(state)}
    age = max(0, now - float(doc.get("wall_t", 0)))
    doc["app"] = app
    doc["age_s"] = round(age, 1)
    doc["service"] = state
    if age > 30:
        doc["health"] = {"state": "fault", "detail": f"status stale for {age:.0f}s"}
    return doc


def overall_health(apps):
    states = [
        item.get("health", {}).get("state", "unknown")
        for item in apps
        if item.get("health", {}).get("state") not in ("disabled", "unavailable")
    ]
    if not states:
        return "unknown"
    if "fault" in states:
        return "fault"
    if any(state in ("degraded", "unknown") for state in states):
        return "degraded"
    return "ok"


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("command", nargs="?", default="status", choices=("status",))
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    now = time.time()
    apps = [load(app, now) for app in APPS]
    overall = overall_health(apps)
    payload = {"schema": 1, "wall_t": round(now, 3), "health": {"state": overall}, "apps": apps}
    if args.json:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(overall)
        for item in apps:
            health = item.get("health", {})
            print(f"{item['app']}: {health.get('state', 'unknown')} {health.get('detail', '')}".rstrip())


if __name__ == "__main__":
    main()
