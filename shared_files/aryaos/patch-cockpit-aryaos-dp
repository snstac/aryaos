TIME_JS = """
/* --- Manual system time seed --- */
const TIME_HELPER = "/usr/local/sbin/aryaos-time-bootstrap";
let deviceTimeSample = null;

function formatClock(epochMs) {
    const value = Number(epochMs);
    if (!Number.isFinite(value)) return "unavailable";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "unavailable";
    return date.toLocaleString() + " (" + date.toISOString() + ")";
}

function formatClockOffset(offsetMs) {
    const value = Number(offsetMs);
    if (!Number.isFinite(value)) return "unavailable";
    const seconds = Math.abs(value) / 1000;
    if (seconds < 1) return "Within one second";
    const amount = seconds < 120 ? Math.round(seconds) + " seconds" : Math.round(seconds / 60) + " minutes";
    return "Device is " + amount + (value > 0 ? " ahead" : " behind");
}

function renderSystemTime() {
    const browserNow = Date.now();
    $("time-browser").textContent = formatClock(browserNow);
    if (!deviceTimeSample) return;
    const deviceNow = deviceTimeSample.epochMs + (browserNow - deviceTimeSample.receivedAt);
    $("time-device").textContent = formatClock(deviceNow);
    $("time-offset").textContent = formatClockOffset(deviceNow - browserNow);
}

function refreshSystemTime() {
    const requestedAt = Date.now();
    return cockpit.spawn([TIME_HELPER, "status"], { err: "message" })
        .then((out) => {
            const receivedAt = Date.now();
            const payload = JSON.parse(out);
            const epochMs = Number(payload.system_epoch_ms);
            if (!Number.isFinite(epochMs)) throw new Error("The device returned an invalid clock value.");
            deviceTimeSample = { epochMs, receivedAt: (requestedAt + receivedAt) / 2 };
            let source = payload.source || payload.last_good_source || "unknown";
            if ((source === "none" || source === "local") && payload.last_good_source) {
                source = payload.last_good_source + " floor";
            }
            const state = payload.state || (payload.synchronized ? "synchronized" : "not synchronized");
            const timezone = payload.timezone || "UTC";
            $("time-source").textContent = source + "; " + state + "; " + timezone;
            renderSystemTime();
            const status = $("time-status");
            if (status.textContent.startsWith("Failed to read device time:")) {
                status.textContent = "";
                status.className = "aos-status";
            }
        })
        .catch((ex) => setStatus($("time-status"), "Failed to read device time: " + (ex.message || ex), false));
}

function syncSystemTime() {
    const warning = "Set the device clock from this browser? This can change log order and certificate checks.";
    if (!window.confirm(warning)) return;
    const button = $("btn-time-sync");
    const status = $("time-status");
    button.disabled = true;
    status.textContent = "Requesting administrator access...";
    status.className = "aos-status";
    cockpit.spawn(["/usr/bin/true"], { superuser: "require", err: "message" })
        .then(() => {
            const browserEpochMs = Date.now();
            status.textContent = "Setting device time...";
            return cockpit.spawn([TIME_HELPER, "set-browser", String(browserEpochMs)],
                { superuser: "require", err: "message" });
        })
        .then((out) => {
            const payload = JSON.parse(out);
            if (!payload.ok) throw new Error(payload.error || "The device rejected the new time.");
            const rtc = payload.rtc_updated ? "The hardware clock was updated." : "No hardware clock was updated.";
            const chrony = payload.chrony_resumed ? "Chrony resumed." : "Chrony did not resume.";
            setStatus(status, "Device time updated. " + rtc + " " + chrony, true);
            return refreshSystemTime();
        })
        .catch((ex) => setStatus(status, "Failed to set device time: " + (ex.message || ex), false))
        .finally(() => { button.disabled = false; });
}

