def add_launcher_html(text):
    """Add the workflow launcher before the first operational card."""
    if 'class="aos-launcher"' in text:
        return text
    for marker in (
        '    <section class="aos-safebanner" id="safe-mode-banner"',
        '    <section class="aos-card aos-card-location" id="card-location"',
    ):
        if marker in text:
            return text.replace(marker, LAUNCHER_HTML + marker, 1)
    raise RuntimeError(f"{INDEX}: workflow launcher marker not found")


