#!/bin/bash
# aryaos-role — set the device's sensor capabilities at runtime.
#
# A box is described by its CAPABILITIES: which receivers are attached and
# active. There is deliberately no product-line label. One used to exist, but it
# was written into the image at build time and never derived from anything, so
# every box advertised the same value regardless of its hardware -- a field that
# was worse than absent, because it looked authoritative. What differs between
# boxes is the capability mix, and that is measured (aryaos-capability-scan).
#
# Capabilities map to sensor systemd units; a capability set enables the union of
# those units and disables the rest. The CoT core (cotbridge, lincot, gpscot,
# gpsd) is never touched — it always runs.
#
# Subcommands:
#   list                 JSON: capabilities, available caps/units, roles.
#   caps CAP...          Set the active capability set (space/comma separated).
#                        Use "none" to disable every sensor (bare CoT node).
#   apply-detected CAP... Configure protocol-verified transports, then set the
#                        detected capability set. Used by first boot/discovery.
#   discover [--apply]   Detect attached hardware and report which capabilities
#                        it supports; --apply enables them.
#   set ROLE             Back-compat: apply a legacy role as a capability preset.
#
# Capability keys: adsb ais acars dji wifi-rid ble-rid rid sik sapient
# The ADS-B decoder unit follows ARYAOS_ADSB_DECODER (readsb | dump1090_fa).
# Units missing from the image are skipped, not errors.
#
# Backend for the "Device role" card in Cockpit -> AryaOS Site.
#
# Copyright Sensors & Signals LLC https://www.snstac.com/
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

SITE_CONFIG="/etc/aryaos/aryaos-config.txt"
# No product line. It was a label baked into the image at build time and never
# derived from anything, so every box claimed the same one no matter what was
# attached. Capabilities are what differ between boxes, and unlike the product
# they are measured -- see aryaos-capability-scan.
CAPS="adsb ais acars dji wifi-rid ble-rid rid sik sapient"
LEGACY_ROLES="multi air maritime cuas relay"

usage() {
	echo "usage: aryaos-role {list | discover [--apply] | caps CAP... | apply-detected CAP... | set ROLE}" >&2
	echo "  caps:     ${CAPS}  (or 'none' for a bare CoT node)" >&2
	echo "  roles:    ${LEGACY_ROLES}  (legacy presets)" >&2
	exit 2
}

require_root() {
	if [[ "$(id -u)" != "0" ]]; then
		echo "aryaos-role: must run as root (try sudo)" >&2
		exit 2
	fi
}

config_get() {
	local key="$1"
	[[ -f "${SITE_CONFIG}" ]] || return 0
	sed -n "s/^${key}=[\"']\?\([^\"']*\)[\"']\?$/\1/p" "${SITE_CONFIG}" | tail -1
}

config_set() {
	local key="$1" value="$2"
	if grep -qE "^#?\s*${key}=" "${SITE_CONFIG}"; then
		sed -i "s|^#\?\s*${key}=.*|${key}=\"${value}\"|" "${SITE_CONFIG}"
	else
		printf '%s="%s"\n' "${key}" "${value}" >> "${SITE_CONFIG}"
	fi
}

adsb_decoder_unit() {
	local decoder
	decoder="$(config_get ARYAOS_ADSB_DECODER)"
	if [[ "${decoder}" == "dump1090_fa" ]]; then
		echo "dump1090-fa"
	else
		echo "readsb"
	fi
}

# Capability -> systemd sensor units.
cap_units() {
	case "$1" in
		adsb)
			# ADSBee is a 1090 MHz Beast source. Do not start the independent
			# dump978 UAT decoder when discovery selected it: there is no RTL-SDR
			# for dump978 to open, and doing so would create a permanent restart
			# loop on an otherwise healthy ADSBee box.
			if [[ "$(config_get ARYAOS_ADSB_1090_SOURCE)" == "adsbee" ]]; then
				echo "$(adsb_decoder_unit) adsbcot gdlcot"
			else
				echo "$(adsb_decoder_unit) dump978-fa adsbcot gdlcot"
			fi
			;;
		ais)      echo "ais-catcher aiscot" ;;
		# Decoder and gateway, same split as readsb/adsbcot: acarsdec
		# demodulates VHF, acarscot turns its JSON into CoT.
		acars)    echo "acarsdec acarscot" ;;
		dji)      echo "dronecot-dji" ;;
		wifi-rid) echo "dronecot-wifi" ;;
		ble-rid)  echo "dronecot-ble" ;;
		rid)      echo "dronecot-dronescout" ;;
		sik)      echo "sikw00fcot" ;;
		sapient)  echo "sapientcot" ;;
		*)        return 1 ;;
	esac
}

# Capability -> human-readable label (used by the beacon and Cockpit).
cap_label() {
	case "$1" in
		adsb)     echo "ADS-B / UAT" ;;
		ais)      echo "AIS" ;;
		acars)    echo "ACARS" ;;
		dji)      echo "DJI DroneID" ;;
		wifi-rid) echo "Wi-Fi Remote ID" ;;
		ble-rid)  echo "Bluetooth Remote ID" ;;
		rid)      echo "Remote ID receiver" ;;
		sik)      echo "SiK Telemetry" ;;
		sapient)  echo "SAPIENT C-UAS" ;;
		*)        echo "$1" ;;
	esac
}

# Legacy role -> capability set (back-compat for `set` and Cockpit's role card).
role_caps() {
	case "$1" in
		multi)    echo "adsb ais dji sik sapient" ;;
		air)      echo "adsb" ;;
		maritime) echo "ais" ;;
		cuas)     echo "dji sik sapient" ;;
		relay)    echo "" ;;
		*)        return 1 ;;
	esac
}

all_managed_units() {
	echo "readsb dump1090-fa dump978-fa adsbcot gdlcot ais-catcher aiscot acarsdec acarscot \
		dronecot-dji dronecot-wifi dronecot-ble dronecot-dronescout sikw00fcot sapientcot"
}

# Expand a capability list to the (deduplicated) union of its units.
# Accept the retired 'ds101' key and map it to 'rid'. The capability was named
# after one BlueMark model, but the same code path serves a DroneScout Bridge
# (DS110) and anything else speaking MAVLink Open Drone ID over serial, so the
# key is now model-neutral. Deployed boxes may still have ds101 persisted in
# aryaos-config.txt.
normalize_caps() {
	local cap out=""
	for cap in $1; do
		[[ "${cap}" == "ds101" ]] && cap="rid"
		out="${out}${cap} "
	done
	echo "${out% }"
}

units_for_caps() {
	local cap u seen=" "
	for cap in $1; do
		for u in $(cap_units "${cap}" 2>/dev/null || true); do
			[[ "${seen}" == *" ${u} "* ]] || { printf '%s ' "${u}"; seen="${seen}${u} "; }
		done
	done
}

NM_UNMANAGE_CONF="/etc/NetworkManager/conf.d/99-aryaos-wifi-rid-unmanaged.conf"

# The Wi-Fi Remote ID monitor adapter must not be managed by NetworkManager /
# wpa_supplicant: on an ath9k_htc monitor interface wpa_supplicant logs
# "Registration to specific type not supported", and NM flaps the link out from
# under the dronecot-wifi sniffer. Persist an unmanaged marker while the wifi-rid
# capability is active; remove it otherwise. Gated on the capability so boxes
# that use the adapter as a normal client are unaffected.
wifi_rid_nm_unmanage() {
	local active="$1" iface="wlan1"
	if [[ -r /etc/default/dronecot-wifi ]]; then
		iface="$(sed -n 's/^WIFI_INTERFACE=//p' /etc/default/dronecot-wifi | tail -1 | tr -d '"' | xargs || true)"
	fi
	iface="${iface:-wlan1}"
	if [[ "${active}" == 1 ]]; then
		install -d -m 0755 /etc/NetworkManager/conf.d 2>/dev/null || true
		printf '# Managed by aryaos-role (wifi-rid capability). Do not edit.\n[keyfile]\nunmanaged-devices=interface-name:%s\n' \
			"${iface}" > "${NM_UNMANAGE_CONF}"
	else
		rm -f "${NM_UNMANAGE_CONF}" 2>/dev/null || true
	fi
	systemctl reload NetworkManager 2>/dev/null || nmcli general reload 2>/dev/null || true
}

unit_exists() {
	# Capture and test rather than `systemctl ... | grep -q .`: under
	# `set -o pipefail`, grep -q closes the pipe on its first match, systemctl
	# gets SIGPIPE, and the pipeline reports failure — which would make this
	# return false for units that exist, so `apply` would enable nothing.
	local out
	out="$(systemctl list-unit-files --no-legend "$1.service" 2>/dev/null || true)"
	[[ -n "${out}" ]]
}

# Enable the wanted units, disable every other managed unit.
apply_units() {
	local wanted="$1" unit
	for unit in $(all_managed_units); do
		unit_exists "${unit}" || continue
		if [[ " ${wanted} " == *" ${unit} "* ]]; then
			echo "enable  ${unit}"
			systemctl enable --now "${unit}" >/dev/null 2>&1 || \
				echo "aryaos-role: warning: could not start ${unit}" >&2
		else
			echo "disable ${unit}"
			systemctl disable --now "${unit}" >/dev/null 2>&1 || true
			# Clear any leftover failed state. `disable --now` stops a unit but
			# does NOT clear a failure it recorded earlier, so a service that
			# crash-looped under a previous capability set stays in
			# `systemctl --failed` forever and holds the whole box in
			# `degraded` -- for a service we just deliberately switched off.
			#
			# Seen on aryaos-c998: switching from adsb (a LimeSDR that readsb
			# cannot drive) to ble-rid left readsb, adsbcot and gdlcot listed as
			# failed while ble-rid ran perfectly. The box reported degraded and
			# an operator had no way to tell that from a real fault.
			systemctl reset-failed "${unit}" >/dev/null 2>&1 || true
		fi
	done
}

# A silent dAISy can only be assigned by elimination when ais-catcher is enabled.
# Enable (but do not start) the unit and assign the serial input before
# apply_units starts it. Starting first makes AIS-catcher parse an empty -e port,
# exit, and enter a restart cycle until assignment catches up.
prepare_serial_ais() {
	local wanted="$1"
	[[ " ${wanted} " == *" ais-catcher "* ]] || return 0
	unit_exists ais-catcher || return 0
	[[ -x /usr/local/sbin/aryaos-serial-assign ]] || return 0
	systemctl enable ais-catcher.service >/dev/null 2>&1 || true
	/usr/local/sbin/aryaos-serial-assign || true
}

# Persist caps + a nearest-legacy-role alias and clear SDR re-tasks.
persist_and_settle() {
	local caps="$1"
	config_set ARYAOS_CAPABILITIES "${caps}"
	local r
	for r in ${LEGACY_ROLES}; do
		[[ "$(role_caps "${r}")" == "${caps}" ]] && { config_set ARYAOS_ROLE "${r}"; break; }
	done
	rm -f /etc/aryaos/sdr-tasks 2>/dev/null || true
}

set_caps() {
	local caps
	caps="$(echo "$1" | tr ',' ' ' | xargs || true)"
	# "none"/"off" is the explicit way to run a bare CoT node — clearer than
	# passing a quoted empty string, and it is what the image ships as.
	case "${caps}" in
		none | off) caps="" ;;
	esac
	# Map retired keys (ds101 -> rid) before validation, so deployed boxes and
	# existing muscle memory keep working.
	caps="$(normalize_caps "${caps}")"
	local cap
	for cap in ${caps}; do
		cap_units "${cap}" >/dev/null 2>&1 || { echo "aryaos-role: unknown capability '${cap}' (caps: ${CAPS})" >&2; exit 2; }
	done
	local wanted
	wanted="$(units_for_caps "${caps}" | xargs || true)"
	prepare_serial_ais "${wanted}"
	apply_units "${wanted}"
	if [[ " ${caps} " == *" wifi-rid "* ]]; then wifi_rid_nm_unmanage 1; else wifi_rid_nm_unmanage 0; fi
	persist_and_settle "${caps}"
	echo "Capabilities set to: ${caps:-<none>}"
}

CAP_SCAN="/usr/local/sbin/aryaos-capability-scan"

# Apply transport details that cannot be expressed by a capability name alone.
# Every path comes from a protocol-verified scanner result, not a generic USB id.
configure_detected_inputs() {
	local caps="$1" adsbee="" rid_port="" rid_feed_port="" rid_transport="" rid_crlf="0"

	if [[ " ${caps} " == *" adsb "* ]]; then
		adsbee="$("${CAP_SCAN}" --adsbee-port 2>/dev/null | head -1 || true)"
		if [[ -n "${adsbee}" ]]; then
			if [[ ! "${adsbee}" =~ ^/dev/serial/by-id/[A-Za-z0-9._:+-]+$ ]]; then
				echo "aryaos-role: refusing unsafe ADSBee path '${adsbee}'" >&2
				return 1
			fi
			if [[ -f /etc/default/readsb ]]; then
				if grep -q '^RECEIVER_OPTIONS=' /etc/default/readsb; then
					sed -i -E "s|^RECEIVER_OPTIONS=.*|RECEIVER_OPTIONS=\"--device-type modesbeast --beast-serial ${adsbee} --beast-baudrate 115200\"|" /etc/default/readsb
				else
					printf 'RECEIVER_OPTIONS="--device-type modesbeast --beast-serial %s --beast-baudrate 115200"\n' "${adsbee}" >> /etc/default/readsb
				fi
			fi
			config_set ARYAOS_ADSB_DECODER readsb
			config_set ARYAOS_ADSB_1090_SOURCE adsbee
			config_set ARYAOS_ADSB_1090_DEVICE "${adsbee}"
			echo "configure readsb <- ADSBee ${adsbee} (Mode-S Beast)"
		else
			# Clear a stale discovery marker. Deliberate/manual readsb options are
			# left untouched; aryaos-sdr owns RTL/Soapy receiver selection.
			config_set ARYAOS_ADSB_1090_SOURCE auto
			config_set ARYAOS_ADSB_1090_DEVICE ""
		fi
	fi

	if [[ " ${caps} " == *" rid "* ]]; then
		rid_port="$("${CAP_SCAN}" --rid-port 2>/dev/null | head -1 || true)"
		if [[ -n "${rid_port}" ]]; then
			rid_transport="$("${CAP_SCAN}" --rid-transport 2>/dev/null | head -1 || true)"
			if [[ "${rid_transport}" == "esp32-usb" ]]; then
				rid_crlf="1"
			fi
			if [[ ! "${rid_port}" =~ ^/dev/serial/by-id/[A-Za-z0-9._:+-]+$ ]]; then
				echo "aryaos-role: refusing unsafe DroneScout path '${rid_port}'" >&2
				return 1
			fi
			rid_feed_port="${rid_port}"
			# Espressif's stable by-id name embeds a MAC address with colons.
			# pymavlink treats ANY device string containing ':' as UDP before it
			# checks whether that string names a tty, so the apparently-correct
			# serial URL leaves dronecot active but retrying forever. Prefer the
			# colon-free udev alias only when it resolves to the exact port whose
			# MAVLink Remote-ID payload the scanner verified.
			if [[ -e /dev/dronescout ]] \
				&& [[ "$(readlink -f /dev/dronescout 2>/dev/null)" == "$(readlink -f "${rid_port}" 2>/dev/null)" ]]; then
				rid_feed_port="/dev/dronescout"
			elif [[ "${rid_port}" == *:* ]]; then
				echo "aryaos-role: verified DroneScout path contains ':' and no matching colon-free /dev/dronescout alias exists" >&2
				return 1
			fi
			if [[ -f /etc/default/dronecot-dronescout ]]; then
				if grep -q '^FEED_URL=' /etc/default/dronecot-dronescout; then
					sed -i -E "s|^FEED_URL=.*|FEED_URL=serial://${rid_feed_port}:115200|" /etc/default/dronecot-dronescout
				else
					printf 'FEED_URL=serial://%s:115200\n' "${rid_feed_port}" >> /etc/default/dronecot-dronescout
				fi
				if grep -q '^SERIAL_CRLF_NORMALIZE=' /etc/default/dronecot-dronescout; then
					sed -i -E "s|^SERIAL_CRLF_NORMALIZE=.*|SERIAL_CRLF_NORMALIZE=${rid_crlf}|" /etc/default/dronecot-dronescout
				else
					printf 'SERIAL_CRLF_NORMALIZE=%s\n' "${rid_crlf}" >> /etc/default/dronecot-dronescout
				fi
			fi
			echo "configure dronecot-dronescout <- ${rid_feed_port} (verified as ${rid_port}; ${rid_transport:-unknown transport}; MAVLink 2 @ 115200)"
		fi
	fi
}

# Apply a capability set that came from aryaos-capability-scan. Unlike the
# operator-facing `caps` command, this also wires device-specific transports
# (for example ADSBee Beast serial and the colon-safe DroneScout alias) before
# any newly selected service starts.
apply_detected_caps() {
	local caps="$1" cap
	caps="$(normalize_caps "${caps}")"
	for cap in ${caps}; do
		cap_units "${cap}" >/dev/null 2>&1 || {
			echo "aryaos-role: unknown capability '${cap}' (caps: ${CAPS})" >&2
			exit 2
		}
	done
	configure_detected_inputs "${caps}"
	set_caps "${caps}"
}

# Detect attached hardware and (optionally) enable the capabilities it supports.
# Report-only by default: seeing what a box COULD do should never change what it
# IS doing without being asked.
discover() {
	local apply="${1:-0}"
	if [[ ! -x "${CAP_SCAN}" ]]; then
		echo "aryaos-role: ${CAP_SCAN} not installed" >&2
		exit 2
	fi

	local detected
	detected="$("${CAP_SCAN}" --caps 2>/dev/null | xargs || true)"

	echo "Detected hardware capabilities: ${detected:-<none>}"
	"${CAP_SCAN}" --report 2>/dev/null || true

	if [[ "${apply}" != 1 ]]; then
		echo
		echo "Nothing changed. Apply with: aryaos-role discover --apply"
		return 0
	fi

	if [[ -z "${detected}" ]]; then
		echo "No sensor hardware detected; leaving capabilities unchanged." >&2
		return 0
	fi
	echo
	apply_detected_caps "${detected}"
}

set_role() {
	local role="$1" caps
	if ! caps="$(role_caps "${role}")"; then
		echo "aryaos-role: unknown role '${role}' (roles: ${LEGACY_ROLES})" >&2
		exit 2
	fi
	set_caps "${caps}"
	echo "Device role set to '${role}'."
}

list_json() {
	local caps
	caps="$(config_get ARYAOS_CAPABILITIES)"
	printf '{"capabilities": "%s", "caps": {' "${caps}"
	local c first=1
	for c in ${CAPS}; do
		[[ "${first}" == "1" ]] || printf ', '
		first=0
		printf '"%s": {"label": "%s", "units": [' "${c}" "$(cap_label "${c}")"
		local u csep=""
		for u in $(cap_units "${c}"); do printf '%s"%s"' "${csep}" "${u}"; csep=", "; done
		printf ']}'
	done
	# Legacy roles block so the existing Cockpit role card keeps working.
	printf '}, "current": "%s", "roles": {' "$(config_get ARYAOS_ROLE)"
	local rfirst=1
	for p in ${LEGACY_ROLES}; do
		[[ "${rfirst}" == "1" ]] || printf ', '
		rfirst=0
		printf '"%s": {"units": [' "${p}"
		local u rsep=""
		for u in $(units_for_caps "$(role_caps "${p}")"); do printf '%s"%s"' "${rsep}" "${u}"; rsep=", "; done
		printf ']}'
	done
	printf '}}\n'
}

cmd="${1:-}"
case "${cmd}" in
	list)
		list_json
		;;
	caps)
		require_root
		[[ $# -ge 2 ]] || usage
		shift
		set_caps "$*"
		;;
	apply-detected)
		require_root
		[[ $# -ge 2 ]] || usage
		shift
		apply_detected_caps "$*"
		;;
	set)
		require_root
		[[ $# -eq 2 ]] || usage
		set_role "$2"
		;;
	discover)
		[[ "${2:-}" == "--apply" ]] && require_root
		discover "$([[ "${2:-}" == "--apply" ]] && echo 1 || echo 0)"
		;;
	*)
		usage
		;;
esac
