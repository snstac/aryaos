{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AryaOS State Contract",
  "type": "object",
  "properties": {
    "schema_version": {"type": "string"},
    "machine": {"type": "string"},
    "states": {"type": "array", "items": {"type": "string"}},
    "initial": {"type": "string"},
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "trigger": {"type": "string"}
        },
        "required": ["from", "to", "trigger"]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string", "enum": ["flag", "counter", "text"]},
          "meaning": {"type": "string"}
        },
        "required": ["path", "kind", "meaning"]
      }
    }
  },
  "required": ["schema_version", "machine", "states", "initial", "transitions", "sources"]
}