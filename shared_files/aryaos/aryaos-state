#!/usr/bin/env python3
import os
import sys
import json
import argparse

STATE_ROOT = os.environ.get("ARYAOS_STATE_ROOT", "/")

def get_source_value(source, root):
    rel_path = source["path"].lstrip("/")
    path = os.path.join(root, rel_path)
    kind = source["kind"]
    
    if not os.path.exists(path):
        return False if kind == "flag" else None

    try:
        if kind == "flag":
            return True
        elif kind == "counter":
            with open(path, "r") as f:
                val = f.read().strip()
                return int(val) if val.isdigit() else 0
        elif kind == "text":
            with open(path, "r") as f:
                return f.read().strip()
    except Exception as e:
        return f"ERROR:{str(e)}"
    return None

def derive_state_refined(machine, contract, root):
    sources = contract.get("sources", [])
    if not sources: return "unknown"

    if machine == "emcon":
        val = get_source_value(sources[0], root)
        if isinstance(val, str) and val.startswith("ERROR:"): return "unknown"
        return "on" if val else "off"
    
    if machine == "zeroize":
        val = get_source_value(sources[0], root)
        if isinstance(val, str) and val.startswith("ERROR:"): return "unknown"
        return "zeroizing" if val else "normal"
        
    if machine == "safe-mode":
        flag_val = get_source_value(sources[0], root)
        if isinstance(flag_val, str) and flag_val.startswith("ERROR:"): return "unknown"
        if flag_val: return "safe"
        
        if len(sources) > 1:
            counter_val = get_source_value(sources[1], root)
            if isinstance(counter_val, str) and counter_val.startswith("ERROR:"): return "unknown"
            if isinstance(counter_val, int) and counter_val > 0:
                return "counting"
        return "normal"
    
    return "unknown"

def main():
    parser = argparse.ArgumentParser(description="AryaOS State CLI")
    parser.add_argument("command", choices=["list", "status"])
    parser.add_argument("machine", nargs="?", help="Machine name")
    parser.add_argument("--json", action="store_true", help="Output JSON")
    
    args = parser.parse_args()
    
    script_dir = os.path.dirname(os.path.realpath(__file__))
    contracts_dir = os.path.join(script_dir, "state")
    
    try:
        contracts = {}
        for f in os.listdir(contracts_dir):
            if f.endswith(".json") and f != "schema.json":
                with open(os.path.join(contracts_dir, f), "r") as jf:
                    c = json.load(jf)
                    contracts[c["machine"]] = c
        
        if args.command == "list":
            machines = sorted(contracts.keys())
            if args.json:
                print(json.dumps({"machines": machines}))
            else:
                print("Available state machines:")
                for m in machines:
                    print(f" - {m}")
        
        elif args.command == "status":
            if not args.machine:
                print("Error: machine required", file=sys.stderr)
                sys.exit(1)
            if args.machine not in contracts:
                print(f"Error: Unknown machine '{args.machine}'", file=sys.stderr)
                sys.exit(1)
                
            contract = contracts[args.machine]
            state = derive_state_refined(args.machine, contract, STATE_ROOT)
            
            if args.json:
                print(json.dumps({"machine": args.machine, "state": state}))
            else:
                print(f"{args.machine}: {state}")
                
    except Exception as e:
        print(f"Error: {str(e)}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
