#!/bin/bash
# aryaos-config-backup — back up and restore the full AryaOS configuration set.
#
# Subcommands:
#   backup [--no-secrets]   Write a restorable tar.gz of all config to
#                           /var/lib/aryaos/backups/ and print its path.
#   restore FILE [--service]  Restore a previously created archive, then restart
#                           services. Prompts for confirmation unless --service.
#   list                    List existing backups (JSON).
#
# Backend for the "Backup & restore" card in Cockpit -> AryaOS Site.
#
# SECURITY: a full backup contains PRIVATE KEYS and Wi-Fi passwords (TAK client
# certs, TLS keys, NetworkManager PSKs, Node-RED credentials). The archive is
# written 0600 root. Use --no-secrets to omit TLS key material and network
# secrets for a shareable config-only backup. Store full backups securely.
#
# Copyright Sensors & Signals LLC https://www.snstac.com/
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

STATE_DIR="/var/lib/aryaos"
OUT_DIR="${STATE_DIR}/backups"
STATE_JSON="${STATE_DIR}/config-backup.json"
KEEP=5

require_root() {
	if [[ "$(id -u)" != "0" ]]; then
		echo "aryaos-config-backup: must run as root (try sudo)" >&2
		exit 2
	fi
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Config paths to capture. Missing paths are skipped, not errors.
#
# Entries may be GLOBS. They used to be a literal, hand-maintained list, and it
# went stale: every gateway added after the list was written was silently left
# out of the backup. Measured on a live box, these existed in /etc/default but
# were NOT captured -- aprscot, sapientcot, ais-catcher, dronecot-ble,
# dronecot-wifi, dronecot-dronescout, readsb, dump1090-fa, dump978-fa.
#
# That is a data-loss bug in the one tool whose entire job is not losing data:
# a factory reset and restore would come back with APRS, SAPIENT, Bluetooth
# Remote ID, Wi-Fi Remote ID, DroneScout and the AIS/ADS-B receiver settings all
# reverted to defaults, and nothing would say so.
#
# Globbing by family means a new gateway is captured the day it lands, with no
# edit here. That is the point: the failure mode was "someone must remember".
config_paths() {
	cat <<'EOF'
etc/aryaos
etc/cotbridge.ini
etc/cotbridge
etc/comitup.conf
etc/comitup.json
etc/default/*cot*
etc/default/*tak*
etc/default/ais-catcher
etc/default/acarsdec
etc/default/gpsd
etc/default/readsb
etc/default/dump1090-fa
etc/default/dump978-fa
etc/adsbcot
etc/aiscot
etc/dronecot
etc/lincot
EOF
}

# Secret-bearing paths, excluded when --no-secrets is given.
secret_paths() {
	cat <<'EOF'
etc/NetworkManager/system-connections
etc/default/gutcheck
home/node-red/.node-red/settings.js
home/node-red/.node-red/flows_cred.json
EOF
}

# tar exclusions applied under --no-secrets (key material inside kept trees).
secret_globs() {
	cat <<'EOF'
--exclude=etc/aryaos/tls
--exclude=etc/cotbridge/tls
--exclude=etc/adsbcot/tls
--exclude=etc/aiscot/tls
--exclude=etc/dronecot/tls
--exclude=etc/lincot/tls
EOF
}

do_backup() {
	require_root
	local include_secrets=1
	[[ "${1:-}" == "--no-secrets" ]] && include_secrets=0

	local host stamp name root
	# tr -d '\n' first: tr -c would otherwise translate hostname's trailing
	# newline into a '-', producing names like aryaos-config_aryaos-4f11-_2026...
	host="$(hostname | tr -d '\n' | tr -c 'A-Za-z0-9.-' '-')"
	# Second-granularity stamp plus the PID, so two backups in the same second
	# (e.g. a full then a --no-secrets from the UI) get distinct names instead
	# of one silently overwriting the other.
	stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
	name="aryaos-config_${host}_${stamp}"
	# 'work' is intentionally global (not local): the EXIT trap runs after this
	# function returns, so a local would be out of scope and, under `set -u`,
	# error ("work: unbound variable") instead of cleaning up the temp dir.
	work="$(mktemp -d)"
	root="${work}/${name}"
	mkdir -p "${root}"
	trap 'rm -rf "${work:-}"' EXIT

	# Build the list of existing paths (relative to /).
	local -a paths=()
	local p m
	while IFS= read -r p; do
		# Entries may be globs, so expand rather than testing the pattern
		# literally. A pattern that matches nothing stays unexpanded and fails
		# the -e test, preserving "missing paths are skipped, not errors".
		for m in /${p}; do
			[[ -e "${m}" ]] && paths+=("${m#/}")
		done
	done < <(config_paths)
	if [[ "${include_secrets}" == "1" ]]; then
		while IFS= read -r p; do
			[[ -e "/${p}" ]] && paths+=("${p}")
		done < <(secret_paths)
	fi

	# Manifest for restore-time sanity.
	{
		echo "aryaos-config-backup"
		echo "created_at: $(now_iso)"
		echo "hostname: $(hostname)"
		echo "aryaos_version: $(cat /etc/aryaos-version 2>/dev/null || echo unknown)"
		echo "include_secrets: ${include_secrets}"
		echo "paths:"
		printf '  - %s\n' "${paths[@]}"
	} > "${root}/MANIFEST.txt"

	mkdir -p "${OUT_DIR}"
	chmod 0700 "${OUT_DIR}"
	local archive="${OUT_DIR}/${name}.tar.gz"

	local -a exclude=()
	if [[ "${include_secrets}" == "0" ]]; then
		while IFS= read -r g; do exclude+=("${g}"); done < <(secret_globs)
	fi

	# Preserve permissions/ownership (system uids are stable across AryaOS images).
	tar -C / -czpf "${archive}" \
		--numeric-owner "${exclude[@]}" \
		-C "${work}" "${name}/MANIFEST.txt" \
		-C / "${paths[@]}"
	chmod 0600 "${archive}"

	# Rotate.
	ls -1t "${OUT_DIR}"/aryaos-config_*.tar.gz 2>/dev/null | tail -n "+$((KEEP + 1))" | xargs -r rm -f

	local size
	size="$(stat -c %s "${archive}")"
	printf '{"created_at": "%s", "path": "%s", "size": %s, "include_secrets": %s}\n' \
		"$(now_iso)" "${archive}" "${size}" "${include_secrets}" > "${STATE_JSON}"

	echo "Backup written (${size} bytes)$([ "${include_secrets}" = 0 ] && echo ', secrets excluded')."
	echo "${archive}"
}

do_restore() {
	require_root
	local file="${1:-}" service=0
	[[ "${2:-}" == "--service" ]] && service=1
	if [[ -z "${file}" || ! -f "${file}" ]]; then
		echo "aryaos-config-backup: restore needs an existing archive path" >&2
		exit 2
	fi
	# Validate it is one of our archives. Read the listing into a variable and
	# match with a here-string rather than `tar ... | grep -q`: under
	# `set -o pipefail`, grep -q closes the pipe on its first match, tar gets
	# SIGPIPE, and the pipeline reports failure — which rejected every valid
	# backup.
	local listing
	listing="$(tar -tzf "${file}" 2>/dev/null || true)"
	if ! grep -q '/MANIFEST.txt$' <<<"${listing}"; then
		echo "aryaos-config-backup: ${file} is not an AryaOS config backup" >&2
		exit 1
	fi

	if [[ "${service}" != "1" ]]; then
		read -r -p "Restore config from ${file}? This overwrites current config. [y/N] " ans
		[[ "${ans}" == "y" || "${ans}" == "Y" ]] || { echo "Aborted."; exit 0; }
	fi

	# Extract everything except the manifest back into place, preserving perms.
	# NOTE: restore is additive — it overlays the backed-up files but does not
	# remove files created since the backup (e.g. a cert uploaded afterwards).
	# Use a factory reset first if you need an exact return to the backed-up set.
	tar -xzpf "${file}" -C / --numeric-owner --exclude='*/MANIFEST.txt'

	# The per-device web certificate is deliberately not part of the config
	# archive. A zeroize removes /etc/lighttpd/ssl, but an older full backup can
	# restore /etc/aryaos/.web-tls-regenerated and make firstboot believe the
	# combined PEM still exists. Reconcile it now so lighttpd works immediately
	# and the restored marker can never suppress regeneration after reboot.
	local web_pem=/etc/lighttpd/ssl/snakeoil-combined.pem
	if [[ ! -s "${web_pem}" ]] && command -v make-ssl-cert >/dev/null 2>&1; then
		if make-ssl-cert generate-default-snakeoil --force-overwrite >/dev/null 2>&1; then
			(
				umask 077
				install -d -m 0755 /etc/lighttpd/ssl
				cat /etc/ssl/certs/ssl-cert-snakeoil.pem /etc/ssl/private/ssl-cert-snakeoil.key \
					>"${web_pem}.tmp"
				mv -f "${web_pem}.tmp" "${web_pem}"
			)
			chmod 0640 "${web_pem}"
			chgrp ssl-cert "${web_pem}" 2>/dev/null || true
			touch /etc/aryaos/.web-tls-regenerated
			echo "Regenerated missing per-device web TLS certificate."
		else
			rm -f /etc/aryaos/.web-tls-regenerated
			echo "Warning: web TLS regeneration failed; first boot will retry." >&2
		fi
	fi

	# Reconcile group access to TAK certs and reload the fleet.
	if command -v systemctl >/dev/null 2>&1; then
		systemctl daemon-reload 2>/dev/null || true
		# shellcheck disable=SC1091
		local svcs="cotbridge gpscot aiscot lincot adsbcot dronecot"
		[[ -f /etc/aryaos/aryaos-config.txt ]] && . /etc/aryaos/aryaos-config.txt 2>/dev/null || true
		[[ -n "${AOS_SERVICES:-}" ]] && svcs="${AOS_SERVICES}"
		# shellcheck disable=SC2086
		systemctl try-restart ${svcs} lighttpd.service 2>/dev/null || true
	fi
	echo "Restore complete. A reboot is recommended to fully apply network and identity changes."
}

do_list() {
	local first=1
	echo -n '{"backups": ['
	if [[ -d "${OUT_DIR}" ]]; then
		local f
		for f in "${OUT_DIR}"/aryaos-config_*.tar.gz; do
			[[ -f "${f}" ]] || continue
			[[ "${first}" == "1" ]] || echo -n ', '
			first=0
			printf '{"path": "%s", "size": %s}' "${f}" "$(stat -c %s "${f}")"
		done
	fi
	echo ']}'
}

case "${1:-}" in
	backup)  shift; do_backup "${1:-}" ;;
	restore) shift; do_restore "${1:-}" "${2:-}" ;;
	list)    do_list ;;
	*) echo "usage: aryaos-config-backup {backup [--no-secrets] | restore FILE [--service] | list}" >&2; exit 2 ;;
esac
