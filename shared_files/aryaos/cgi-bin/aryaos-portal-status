IP = "/usr/sbin/ip"
UPTIME = "/usr/bin/uptime"
GPSD_HOST = "127.0.0.1"
GPSD_PORT = 2947
SYSTEMCTL = "/usr/bin/systemctl"
LSUSB = "/usr/bin/lsusb"
RFKILL_CANDIDATES = ("/usr/sbin/rfkill", "/usr/bin/rfkill")
VCGENCMD = "/usr/bin/vcgencmd"
THERMAL_ZONE0 = "/sys/class/thermal/thermal_zone0/temp"

# Bit labels aligned with shared_files/aryaos/get_throttled.sh (Pi firmware).
THROTTLE_ISSUES = {
    0: "Under-voltage detected",
    1: "Arm frequency capped",
    2: "Currently throttled",
    3: "Soft temperature limit active",
    16: "Under-voltage has occurred",
    17: "Arm frequency capping has occurred",
    18: "Throttling has occurred",
    19: "Soft temperature limit has occurred",
}

SYS_IEEE80211 = "/sys/class/ieee80211"
SYS_NET = "/sys/class/net"
SYS_BT = "/sys/class/bluetooth"
SYS_USB = "/sys/bus/usb/devices"

