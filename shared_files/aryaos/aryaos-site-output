#!/usr/bin/python3
"""Read or atomically update AryaOS's primary COTBridge output."""

import configparser
import json
import os
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlsplit

CONFIG = Path("/etc/aryaos/aryaos-config.txt")
BRIDGE = Path("/etc/cotbridge.ini")
INGRESS = "udp+ro://127.0.0.1:28087"
SECTION = "lane:site-output"
LEGACY_SECTIONS = (
    "lane:local-to-takserver",
    "lane:mesh-to-takserver",
    "lane:local-to-mesh",
)


def valid(url):
    parts = urlsplit(url)
    return parts.scheme in {"udp", "udp+wo", "tcp", "tls", "ssl", "tak", "ws", "wss"} and bool(parts.netloc)


def set_kv(path, key, value):
    lines = path.read_text().splitlines() if path.exists() else []
    out = []
    seen = False
    for line in lines:
        if line.startswith(key + "="):
            out.append(f'{key}="{value}"')
            seen = True
        else:
            out.append(line)
    if not seen:
        out.append(f'{key}="{value}"')
    path.write_text("\n".join(out) + "\n")


def configured_url():
    if not CONFIG.exists():
        return ""
    for raw in CONFIG.read_text().splitlines():
        key, separator, value = raw.partition("=")
        if separator and key.strip() == "ARYAOS_COT_OUTPUT_URL":
            return value.strip().strip('"').strip("'")
    return ""


def selected_output(cp):
    """Return the active canonical or legacy output and its source section."""
    current = cp.get(SECTION, "egress_cot_url", fallback="")
    if valid(current):
        return current, SECTION
    for legacy in LEGACY_SECTIONS:
        if not cp.has_section(legacy):
            continue
        enabled = cp.getboolean(legacy, "enabled", fallback=True)
        candidate = cp.get(legacy, "egress_cot_url", fallback="")
        if enabled and valid(candidate):
            return candidate, legacy
    current = configured_url()
    return (current, None) if valid(current) else ("", None)


def write_bridge(cp):
    BRIDGE.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=BRIDGE.parent, delete=False) as fp:
        cp.write(fp)
        temp = fp.name
    os.chmod(temp, 0o644)
    os.replace(temp, BRIDGE)


def update_output(cp, url, source=None):
    if not cp.has_section("cotbridge"):
        cp.add_section("cotbridge")
    if not cp.has_section(SECTION):
        cp.add_section(SECTION)
    if source and source != SECTION:
        for key, value in cp.items(source):
            cp.set(SECTION, key, value)
    for key, value in {
        "enabled": "true",
        "mode": "forward",
        "ingress_cot_url": INGRESS,
        "egress_cot_url": url,
        "PYTAK_NO_HELLO": "true",
    }.items():
        cp.set(SECTION, key, value)
    for legacy in LEGACY_SECTIONS:
        if cp.has_section(legacy):
            cp.set(legacy, "enabled", "false")
    write_bridge(cp)
    set_kv(CONFIG, "ARYAOS_COT_OUTPUT_URL", url)
    os.system("systemctl try-restart cotbridge.service >/dev/null 2>&1")


def main():
    cp = configparser.RawConfigParser()
    cp.optionxform = str
    cp.read(BRIDGE)
    current, source = selected_output(cp)
    if len(sys.argv) == 1:
        print(json.dumps({"ok": True, "url": current}))
        return
    if sys.argv[1] == "--migrate":
        if not current:
            raise SystemExit("No valid COTBridge output URL to migrate")
        update_output(cp, current, source=source)
        print(json.dumps({"ok": True, "url": current, "migrated": True}))
        return
    url = sys.argv[1].strip()
    if not valid(url) or url.startswith("tak://"):
        raise SystemExit("Use a persistent PyTAK output URL; import tak:// enrollment URLs in TAK connection")
    update_output(cp, url)
    print(json.dumps({"ok": True, "url": url}))


if __name__ == "__main__":
    main()
