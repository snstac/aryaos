#!/usr/bin/env python3
"""Detect which AryaOS sensor capabilities this box's hardware can support.

Reports what is PRESENT, not what is running. `aryaos-role discover` maps this
onto the capability set; the beacon advertises it so the fleet can see "that box
has a Wi-Fi Remote ID adapter but it's switched off".

Honesty rules, because guessing wrong is worse than saying "I don't know":
  * An RTL-SDR can serve ADS-B *or* AIS *or* APRS — one dongle cannot do all
    three at once. Capabilities that share a scarce radio are reported with the
    number of radios available so the caller can decide.
  * A DroneScout may use generic ESP32-S3 USB CDC or a generic USB-UART bridge;
    neither USB id proves what is attached. We require checksum-valid MAVLink
    (and a Remote-ID payload on generic UART bridges) and report silent/broken
    streams as ambiguous.
  * ADSBee uses the generic Raspberry Pi Pico USB id. It must answer a read-only
    ADSBee-specific AT query before it is reported or selected for readsb.
  * SAPIENT is a network sensor with no local hardware signature; it is never
    auto-detected and must be configured deliberately.

Usage:
  aryaos-capability-scan            # full JSON report
  aryaos-capability-scan --caps     # conflict-free set safe to auto-enable
  aryaos-capability-scan --detected # everything the hardware supports
  aryaos-capability-scan --report   # human-readable table

Copyright Sensors & Signals LLC https://www.snstac.com/
SPDX-License-Identifier: Apache-2.0
"""

from __future__ import annotations

import json
import os
import re
import signal
import subprocess
import sys
import glob
import selectors
import termios
import time

CONFIG = "/etc/aryaos/aryaos-config.txt"
ESP32_VID_PID = ("303a", "1001")  # Espressif native USB (DS101 *and* SiKW00F)
ADSBEE_VID_PID = ("2e8a", "000a")  # Generic RP2040 CDC; protocol probe is mandatory.
PL2303_VID_PID = ("067b", "2303")  # DS110 UART adapter, but also many unrelated cables.
RID_MAVLINK_TYPES = {"ADSB_VEHICLE", "OPEN_DRONE_ID_MESSAGE_PACK"}
ONBOARD_WIFI_DRIVERS = {"brcmfmac"}  # the Pi's own radio: never a RID sniffer

# When capabilities contend for one scarce radio, this is the order auto-apply
# prefers. ADS-B first: it is the common air-picture case and the AryaAir
# default. The loser stays "available" and can be enabled by hand.
CONTENTION_PRIORITY = ("adsb", "ais")

# Capability -> the systemd unit that owns its receiver. Mirrors aryaos-role.
CAP_UNITS = {
    "adsb": "adsbcot",
    "ais": "aiscot",
    "acars": "acarscot",
    "dji": "dronecot",
    "wifi-rid": "dronecot-wifi",
    "ble-rid": "dronecot-ble",
    "rid": "dronecot-dronescout",
    "sik": "sikw00fcot",
    "sapient": "sapientcot",
}


def unit_active(unit):
    return _run(["/usr/bin/systemctl", "is-active", f"{unit}.service"], timeout=5) == "active"


def _run(args, timeout=6.0):
    try:
        proc = subprocess.run(
            args, check=False, capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return (proc.stdout or "").strip()


def _read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fp:
            return fp.read()
    except OSError:
        return ""


def _config(key):
    for line in _read(CONFIG).splitlines():
        line = line.strip()
        if line.startswith(f"{key}="):
            return line.split("=", 1)[1].strip().strip("\"'")
    return ""


# --- individual probes ------------------------------------------------------


def probe_sdrs():
    """Enumerate local SDRs without waiting for network discovery/Avahi.

    A generic Soapy ``--find`` loads its network factories. Before Avahi starts,
    that took 60 seconds per scan and held multi-user.target for 106 seconds on a
    bare node. ``list-local`` asks only the USB receiver families AryaOS knows how
    to configure; the interactive ``aryaos-sdr list`` remains universal.
    """
    out = _run(["/usr/local/sbin/aryaos-sdr", "list-local"], timeout=20)
    try:
        return json.loads(out).get("devices", []) if out else []
    except ValueError:
        return []


def probe_wifi_monitor():
    """Find an external Wi-Fi adapter that could run monitor mode."""
    found = []
    for path in sorted(glob.glob("/sys/class/net/wlan*")):
        iface = os.path.basename(path)
        driver = ""
        try:
            driver = os.path.basename(os.path.realpath(f"{path}/device/driver"))
        except OSError:
            pass
        if not driver or driver in ONBOARD_WIFI_DRIVERS:
            continue
        found.append({"interface": iface, "driver": driver})
    return found


def probe_onboard_bt():
    """Find a Bluetooth adapter capable of receiving Remote ID advertisements.

    Unlike every other probe there is no add-on hardware to look for: the board's
    own radio is always there. That is exactly why 'ble-rid' must NOT auto-apply
    (see scan()) — detecting it on every box in the fleet is not a reason to
    switch a sensor on across the fleet.
    """
    adapters = []
    for path in sorted(glob.glob("/sys/class/bluetooth/hci*")):
        # sysfs exposes no 'address' attribute for hci devices, so identify the
        # adapter by its driver instead: hci_uart/btbcm is the Pi's own radio,
        # btusb an add-on dongle.
        driver = ""
        try:
            driver = os.path.basename(os.path.realpath(f"{path}/device/driver"))
        except OSError:
            pass
        adapters.append({"adapter": os.path.basename(path), "driver": driver})
    return adapters


def probe_esp32_serial():
    """Locate ESP32-S3 USB-serial ports (DS101 and/or SiKW00F)."""
    ports = []
    for path in sorted(glob.glob("/dev/serial/by-id/*")):
        props = _run(["/usr/bin/udevadm", "info", "-q", "property", "-n", path])
        vid = re.search(r"^ID_VENDOR_ID=(\S+)$", props, re.M)
        pid = re.search(r"^ID_MODEL_ID=(\S+)$", props, re.M)
        if vid and pid and (vid.group(1), pid.group(1)) == ESP32_VID_PID:
            ports.append(path)
    return ports


def _serial_properties(path):
    """Return the stable udev identity fields used to select probe candidates."""
    props = _run(["/usr/bin/udevadm", "info", "-q", "property", "-n", path])
    values = {}
    for key in ("ID_VENDOR_ID", "ID_MODEL_ID", "ID_MODEL", "ID_SERIAL"):
        match = re.search(rf"^{key}=(\S+)$", props, re.M)
        values[key] = match.group(1) if match else ""
    return values


def _serial_ports_by_id(vid_pid):
    ports = []
    for path in sorted(glob.glob("/dev/serial/by-id/*")):
        props = _serial_properties(path)
        if (props["ID_VENDOR_ID"], props["ID_MODEL_ID"]) == vid_pid:
            ports.append(path)
    return ports


def _open_nonblocking_with_timeout(port, seconds=1.0, flags=None):
    """Open a serial device without letting a wedged USB tty block discovery."""

    def timed_out(_signum, _frame):
        raise TimeoutError

    previous = signal.signal(signal.SIGALRM, timed_out)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        if flags is None:
            flags = os.O_RDONLY
        return os.open(port, flags | os.O_NONBLOCK | os.O_NOCTTY)
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def _close_with_timeout(fd, seconds=1.0):
    """Close a USB tty without hanging discovery in a driver drain path."""

    def timed_out(_signum, _frame):
        raise TimeoutError

    previous = signal.signal(signal.SIGALRM, timed_out)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        os.close(fd)
    except (OSError, TimeoutError):
        pass
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def _set_raw_115200(fd):
    """Temporarily put a tty in the mode used by DroneScout and ADSBee."""
    old = termios.tcgetattr(fd)
    attrs = termios.tcgetattr(fd)
    attrs[0] = 0
    attrs[1] = 0
    attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
    attrs[3] = 0
    attrs[4] = termios.B115200
    attrs[5] = termios.B115200
    attrs[6][termios.VMIN] = 0
    attrs[6][termios.VTIME] = 0
    termios.tcsetattr(fd, termios.TCSANOW, attrs)
    return old


def _restore_tty(fd, attrs):
    if attrs is None:
        return
    try:
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
    except (OSError, termios.error):
        pass


def _read_serial(port, seconds=3, limit=65536):
    """Read a bounded 115200/8N1 sample and describe transport failures."""
    if not port or not os.path.exists(port):
        return {"status": "absent", "bytes": b""}
    if _run(["/usr/bin/fuser", port], timeout=3):
        return {"status": "busy", "bytes": b""}
    try:
        fd = _open_nonblocking_with_timeout(port)
    except (OSError, TimeoutError):
        return {"status": "open-failed", "bytes": b""}

    old = None
    sel = None
    buf = bytearray()
    try:
        old = _set_raw_115200(fd)
        sel = selectors.DefaultSelector()
        sel.register(fd, selectors.EVENT_READ)
        end = time.monotonic() + seconds
        while time.monotonic() < end and len(buf) < limit:
            if not sel.select(timeout=min(0.5, max(0, end - time.monotonic()))):
                continue
            try:
                chunk = os.read(fd, min(4096, limit - len(buf)))
            except (OSError, BlockingIOError):
                break
            if not chunk:
                break
            buf.extend(chunk)
    except (OSError, termios.error):
        return {"status": "io-error", "bytes": bytes(buf)}
    finally:
        if sel is not None:
            sel.close()
        _restore_tty(fd, old)
        _close_with_timeout(fd)

    data = bytes(buf)
    if not data:
        status = "silent"
    elif not data.strip(b"\x00"):
        # A powered UART should idle high. A continuous zero stream is a break /
        # stuck-low line, not evidence that a DroneScout is speaking MAVLink.
        status = "stuck-low"
    else:
        status = "data"
    return {"status": status, "bytes": data}


def _mavlink_message_types(data):
    """Return message names from checksum-valid MAVLink v1/v2 frames."""
    try:
        from pymavlink.dialects.v20 import all as mavlink
    except ImportError:
        return []
    parser = mavlink.MAVLink(None)
    parser.robust_parsing = True
    found = []
    for byte in data:
        try:
            msg = parser.parse_char(bytes((byte,)))
        except Exception:  # pymavlink raises on malformed partial frames.
            continue
        if msg is not None and msg.get_type() != "BAD_DATA":
            found.append(msg.get_type())
    return sorted(set(found))


def probe_mavlink_stream(port, seconds=3):
    """Describe a serial stream and validate MAVLink checksums."""
    sample = _read_serial(port, seconds=seconds)
    data = sample.pop("bytes")
    message_types = _mavlink_message_types(data)
    if message_types:
        sample["status"] = "mavlink"
    sample["bytes_read"] = len(data)
    sample["message_types"] = message_types
    return sample


def probe_mavlink(port, seconds=3):
    """Does this port emit checksum-valid MAVLink?"""
    return probe_mavlink_stream(port, seconds=seconds)["status"] == "mavlink"


def probe_adsbee(port, seconds=3):
    """Identify an ADSBee without mistaking every RP2040 Pico for one.

    The USB VID/PID and product string are Raspberry Pi's generic Pico defaults.
    A read-only ADSBee-specific AT query is therefore required. The command does
    not save settings, reset the radio, or interrupt its configured Beast stream.
    """
    if not port or not os.path.exists(port):
        return False
    if _run(["/usr/bin/fuser", port], timeout=3):
        return False
    try:
        fd = _open_nonblocking_with_timeout(port, flags=os.O_RDWR)
    except (OSError, TimeoutError):
        return False
    old = None
    sel = None
    try:
        old = _set_raw_115200(fd)
        termios.tcflush(fd, termios.TCIFLUSH)
        os.write(fd, b"AT+BIAS_TEE_ENABLE?\r\n")
        sel = selectors.DefaultSelector()
        sel.register(fd, selectors.EVENT_READ)
        end = time.monotonic() + seconds
        buf = bytearray()
        while time.monotonic() < end and len(buf) < 8192:
            if sel.select(timeout=min(0.5, max(0, end - time.monotonic()))):
                try:
                    chunk = os.read(fd, 4096)
                except (OSError, BlockingIOError):
                    break
                if not chunk:
                    break
                buf.extend(chunk)
        # Beast frames can end immediately before the textual AT reply, so no
        # line boundary is guaranteed on the left. The command name + exact
        # two-boolean response remains ADSBee-specific.
        return bool(re.search(rb"BIAS_TEE_ENABLE=[01],[01][\r\n]", bytes(buf)))
    except (OSError, termios.error):
        return False
    finally:
        if sel is not None:
            sel.close()
        _restore_tty(fd, old)
        _close_with_timeout(fd)


def probe_adsbee_serial():
    candidates = _serial_ports_by_id(ADSBEE_VID_PID)
    verified = [port for port in candidates if probe_adsbee(port)]
    if verified:
        return verified

    # Once readsb owns the tty, discovery deliberately refuses to inject an AT
    # query into the live feed. Preserve the earlier protocol verification when
    # the role manager recorded ADSBee as the source and readsb still names the
    # same present RP2040 path. Without this, a second `discover --apply` would
    # forget the source, re-enable dump978, and manufacture a restart loop.
    if _config("ARYAOS_ADSB_SOURCE") == "adsbee":
        options = _read("/etc/default/readsb")
        match = re.search(r"--device-type\s+modesbeast\b.*?--beast-serial\s+(\S+)", options)
        if match and match.group(1) in candidates:
            return [match.group(1)]
    return []


def probe_ds110_uart_candidates():
    """PL2303 cables need protocol evidence; the USB id alone is never enough."""
    return _serial_ports_by_id(PL2303_VID_PID)


def probe_antsdr():
    """Is an AntSDR present on the point-to-point link?"""
    bind = ""
    for line in _read("/etc/default/dronecot").splitlines():
        if line.startswith("DJI_BIND_ADDRESS="):
            bind = line.split("=", 1)[1].strip().strip("\"'")
    bind = bind or "172.31.100.1"
    peer = bind.rsplit(".", 1)[0] + ".2"
    neigh = _run(["/usr/sbin/ip", "neigh", "show", peer], timeout=3)
    if re.search(r"REACHABLE|STALE|DELAY|PROBE", neigh):
        return peer
    if subprocess.call(
        ["/usr/bin/ping", "-c1", "-W1", peer],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ) == 0:
        return peer
    return None


def _is_gnss(port):
    """Does udev identify this serial port as a GNSS receiver?"""
    props = _run(["/usr/bin/udevadm", "info", "-q", "property", "-n", port], timeout=5)
    if re.search(r"^ID_VENDOR_ID=1546$", props, re.M):
        return True
    return bool(re.search(r"^ID_(MODEL|SERIAL|VENDOR)=.*(gps|gnss|u-blox|garmin)", props, re.M | re.I))


def probe_ais_serial():
    """A dAISy (or similar) NMEA AIS receiver wired up by aryaos-serial-assign.

    This reads back the config aryaos-serial-assign WROTE, so on its own it can
    only confirm that assignment -- including a wrong one. Observed on a real box:
    a silent u-blox GPS was assigned to ais-catcher by elimination, and this probe
    then dutifully reported "AIS receiver present", enabling the ais capability on
    a box that had no AIS hardware at all. So reject a port that udev says is a
    GNSS receiver rather than treating the config as ground truth.
    """
    for line in _read("/etc/default/ais-catcher").splitlines():
        if line.startswith("SERIAL_PORT="):
            port = line.split("=", 1)[1].strip().strip("\"'")
            if port and os.path.exists(port):
                if _is_gnss(port):
                    return None
                return port
    return None


# --- capability mapping -----------------------------------------------------


def scan():
    sdrs = probe_sdrs()
    wifi = probe_wifi_monitor()
    esp32 = probe_esp32_serial()
    adsbee = probe_adsbee_serial()
    ds110_uart = probe_ds110_uart_candidates()
    antsdr = probe_antsdr()
    ais_serial = probe_ais_serial()

    caps = {}

    # ADS-B/UAT: needs at least one SDR.
    # ADS-B/UAT needs an SDR the DECODER can actually drive, not merely an SDR.
    #
    # readsb ships with --device-type rtlsdr (see /etc/default/readsb), so a
    # non-RTL SDR makes it exit immediately:
    #
    #   FATAL: rtlsdr: no supported devices found.
    #   sdrOpen() failed, exiting!
    #
    # Measured on aryaos-270d, which has a LimeSDR Mini and nothing else: the
    # probe said "1 SDR(s)" -> adsb auto-applied at firstboot -> readsb
    # crash-looped 10 times, took adsbcot and gdltak down with it (29 restarts
    # between them) and left the box in systemd `degraded` with its whole reason
    # for existing dead. Out of the box, with no operator error.
    #
    # So a usable SDR is an RTL one. A non-RTL SDR still REPORTS the capability,
    # because the hardware genuinely is there and pretending otherwise is its own
    # kind of lie -- but it is not auto-applied, and it says why.
    rtl_sdrs = [d for d in sdrs if str(d.get("driver", "")).lower() == "rtlsdr"]
    other_sdrs = [d for d in sdrs if d not in rtl_sdrs]

    def _labels(ds):
        return ", ".join(d.get("label") or d.get("driver", "?") for d in ds)

    adsb_evidence = []
    if adsbee:
        adsb_evidence.append(f"ADSBee (AT-verified Beast serial) at {adsbee[0]}")
    if sdrs:
        adsb_evidence.append(f"{len(sdrs)} SDR(s): " + _labels(sdrs))
    caps["adsb"] = {
        "available": bool(sdrs or adsbee),
        "evidence": "; ".join(adsb_evidence) or "no ADSBee or SDR detected",
    }
    if sdrs and not rtl_sdrs and not adsbee:
        # manual_only, NOT auto_apply.
        #
        # My first version of this set auto_apply=False directly, and it did
        # nothing: a loop further down unconditionally recomputes
        #     cap["auto_apply"] = available and not manual_only
        # for every capability, so the flag was overwritten a few lines later and
        # the box auto-applied adsb anyway. Observed on aryaos-c998: the
        # deferred_reason was present and correct while auto_apply was true, and
        # readsb crash-looped exactly as before.
        #
        # manual_only is the mechanism the pipeline already has for "available,
        # but never turn it on by itself" -- ble-rid and sapient both use it --
        # and it survives that recomputation because it is an INPUT to it.
        caps["adsb"]["manual_only"] = True
        caps["adsb"]["deferred_reason"] = (
            f"readsb is configured for RTL-SDR (--device-type rtlsdr) and the only "
            f"SDR present is {_labels(other_sdrs)}. Enabling adsb would crash-loop "
            f"readsb. Retune readsb for this device first, then "
            f"`aryaos-role caps ... adsb`."
        )

    # AIS: a dedicated NMEA receiver, or a spare SDR. Flag the contention: with
    # a single SDR, enabling both adsb and ais fights over one radio.
    ais_available = bool(ais_serial) or bool(sdrs)
    ais_ev = []
    if ais_serial:
        ais_ev.append(f"NMEA AIS receiver at {ais_serial}")
    if sdrs and not ais_serial:
        ais_ev.append(f"{len(sdrs)} SDR(s) could run AIS")
    caps["ais"] = {
        "available": ais_available,
        "evidence": "; ".join(ais_ev) or "no AIS receiver detected",
    }
    if sdrs and not ais_serial and len(sdrs) < 2 and not adsbee:
        caps["ais"]["contended_with"] = ["adsb"]
        caps["adsb"]["contended_with"] = ["ais"]

    # DJI DroneID: AntSDR on the point-to-point Ethernet link.
    caps["dji"] = {
        "available": bool(antsdr),
        "evidence": f"AntSDR reachable at {antsdr}" if antsdr else "no AntSDR on link",
    }

    # Wi-Fi Remote ID: an external (non-onboard) Wi-Fi adapter.
    caps["wifi-rid"] = {
        "available": bool(wifi),
        "evidence": (
            "; ".join(f"{w['interface']} ({w['driver']})" for w in wifi)
            if wifi
            else "no external Wi-Fi adapter"
        ),
    }

    # DS101/DroneBeacon uses generic ESP32-S3 USB. A DS110 may be wired through
    # an equally generic PL2303 adapter. Require an actual Remote-ID MAVLink
    # payload in both cases so a SiKW00F or flight-controller cable is not
    # auto-enabled as DroneScout merely because it also speaks MAVLink.
    rid = {"available": False, "evidence": "no DroneScout serial candidate"}
    sik = {"available": False, "evidence": "no ESP32-S3 serial device"}
    rid_serial = None
    rid_probes = []
    for port in dict.fromkeys(esp32 + ds110_uart):
        result = probe_mavlink_stream(port)
        result["port"] = port
        result["transport"] = "esp32-usb" if port in esp32 else "pl2303-uart"
        rid_probes.append(result)
        types = set(result["message_types"])
        if result["status"] == "mavlink" and types.intersection(RID_MAVLINK_TYPES):
            rid_serial = port
            break
    if rid_serial:
        matched = next(p for p in rid_probes if p["port"] == rid_serial)
        rid = {
            "available": True,
            "evidence": (
                f"checksum-valid MAVLink ({', '.join(matched['message_types'])}) "
                f"on {rid_serial}"
            ),
        }
        if rid_serial in esp32:
            sik = {
                "available": False,
                "evidence": "ESP32 present but speaking MAVLink (DroneScout receiver)",
            }
    elif esp32 or ds110_uart:
        details = "; ".join(
            f"{p['port']}={p['status']} ({p['bytes_read']} bytes)" for p in rid_probes
        )
        note = (
            "DroneScout candidate found, but no qualifying Remote-ID MAVLink "
            f"was observed: {details or 'no readable stream'}"
        )
        rid = {"available": False, "ambiguous": True, "evidence": note}
        if esp32:
            sik = {"available": False, "ambiguous": True, "evidence": note}
    caps["rid"] = rid
    caps["sik"] = sik

    # SAPIENT: network sensor, no local signature.
    caps["sapient"] = {
        "available": False,
        "evidence": "network sensor — configure deliberately, never auto-detected",
        "manual_only": True,
    }

    # Bluetooth Remote ID: the ONLY capability needing no add-on hardware, which
    # makes it the only one where "available" must not imply "switch it on".
    # Every box has a Bluetooth radio, so auto-applying would turn a sensor on
    # across the whole fleet — the opposite of shipping everything off by
    # default. It is reported as available so an operator can find it, and waits
    # for `aryaos-role caps ... ble-rid`.
    bt = probe_onboard_bt()
    caps["ble-rid"] = {
        "available": bool(bt),
        "evidence": (
            "Bluetooth adapter "
            + ", ".join(a["adapter"] + (f" ({a['driver']})" if a["driver"] else "") for a in bt)
            + " — legacy advertising only, no BT5 Coded PHY"
            if bt
            else "no Bluetooth adapter detected"
        ),
        "manual_only": True,
        "deferred_reason": (
            "present on every box, so it is never auto-enabled; turn it on with "
            "`aryaos-role caps ... ble-rid`"
        ),
    }

    # ACARS: needs an SDR, and needs it pointed at VHF.
    #
    # manual_only, and the reason is the antenna rather than the radio. ACARS
    # lives around 131 MHz; ADS-B is at 1090 and AIS at 162. A box can see which
    # SDRs are attached but has NO WAY to know what antenna is on the end of the
    # coax, and the antenna decides everything here. Measured on a dragonegg box
    # this session: identical software and SDR went from 0 usable ADS-B messages
    # on a short indoor whip to 5173 on an outdoor antenna, and the same antenna
    # that hears 131 MHz well is the wrong one for 1090.
    #
    # So auto-enabling ACARS because an SDR exists would, on most boxes, start a
    # decoder that hears nothing and claim the capability while doing it. It is
    # reported as available so an operator can find it, and waits to be asked.
    caps["acars"] = {
        "available": bool(sdrs),
        "evidence": (
            f"{len(sdrs)} SDR(s): " + _labels(sdrs) if sdrs else "no SDR detected"
        ),
        "manual_only": True,
        "deferred_reason": (
            "ACARS is VHF (~131 MHz) and needs an antenna to match; a 1090 MHz "
            "ADS-B antenna will hear almost nothing. The box cannot detect which "
            "antenna is attached, so enable it deliberately with "
            "`aryaos-role caps ... acars`."
        ),
    }

    # Auto-apply must be conflict-free. Two capabilities that share one radio
    # would otherwise both be switched on and fight over it — on a single-SDR
    # box that means adsbcot and aiscot each grabbing the same dongle. Keep the
    # higher-priority one and say plainly why the other was held back; the JSON
    # still reports both as available so an operator can choose differently.
    # 'manual_only' capabilities are never auto-applied even when available —
    # ble-rid's radio is present on every board, and SAPIENT is a deliberate
    # network configuration, not a discovery.
    for key, cap in caps.items():
        cap["auto_apply"] = bool(cap.get("available")) and not cap.get("manual_only")
    for key in CONTENTION_PRIORITY:
        cap = caps.get(key)
        if not cap or not cap.get("auto_apply"):
            continue
        for loser in cap.get("contended_with") or []:
            other = caps.get(loser)
            if other and other.get("auto_apply"):
                other["auto_apply"] = False
                other["deferred_reason"] = (
                    f"shares a radio with '{key}'; enable manually with "
                    f"`aryaos-role caps {loser}` (or add a second receiver)"
                )

    # A capability whose gateway is ALREADY RUNNING is available by definition —
    # it is demonstrably working. Without this the probes lie about their own
    # success: a live dronecot-dronescout holds the DS101 serial port, so the
    # MAVLink probe (which deliberately refuses to disturb a busy port) reports
    # nothing, and `discover --apply` would then switch off a capability that is
    # working right now. Observed on a real box: firstboot found "dji rid",
    # a rescan minutes later found only "dji".
    for key, cap in caps.items():
        unit = CAP_UNITS.get(key)
        if unit and unit_active(unit):
            cap["available"] = True
            cap["auto_apply"] = True
            cap["in_use"] = True
            cap["evidence"] = f"{unit}.service is running ({cap.get('evidence', '')})".strip()
            cap.pop("deferred_reason", None)

    return {
        "ok": True,
        "hardware": {
            "sdrs": sdrs,
            "adsbee_serial": adsbee[0] if adsbee else None,
            "wifi_monitor": wifi,
            "esp32_serial": esp32,
            "ds110_uart_candidates": ds110_uart,
            "rid_serial": rid_serial,
            "rid_serial_probes": rid_probes,
            "antsdr": antsdr,
            "ais_serial": ais_serial,
        },
        "capabilities": caps,
        "detected": sorted(k for k, v in caps.items() if v.get("available")),
        "auto_apply": sorted(k for k, v in caps.items() if v.get("auto_apply")),
    }


def report_text(report):
    """Human-readable table for `aryaos-role discover`."""
    lines = []
    auto = report.get("auto_apply") or []
    for key, cap in sorted(report.get("capabilities", {}).items()):
        if cap.get("manual_only"):
            mark = "manual"
        elif cap.get("ambiguous"):
            mark = "AMBIGUOUS"
        elif cap.get("available"):
            mark = "yes" if key in auto else "yes*"
        else:
            mark = "no"
        lines.append("  {:<9} {:<10} {}".format(key, mark, cap.get("evidence", "")))
        reason = cap.get("deferred_reason")
        if reason:
            lines.append("  {:<9} {:<10} {}".format("", "", "* " + reason))
    return "\n".join(lines)


def main():
    if "--adsbee-port" in sys.argv:
        ports = probe_adsbee_serial()
        print(ports[0] if ports else "")
        return 0
    report = scan()
    if "--rid-port" in sys.argv:
        print(report["hardware"].get("rid_serial") or "")
        return 0
    if "--caps" in sys.argv:
        # The auto-apply set, NOT everything detected: firstboot consumes this.
        print(" ".join(report["auto_apply"]))
        return 0
    if "--detected" in sys.argv:
        print(" ".join(report["detected"]))
        return 0
    if "--report" in sys.argv:
        print(report_text(report))
        return 0
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
